# Copy this file to .env.local (never committed) and fill in real values.

# Optional but strongly recommended: a GitHub Personal Access Token
# (read-only "public_repo" scope is enough) used server-side to fetch real
# contributor stats for the "congodevelopersclub" GitHub organization.
# Without it, requests are rate-limited to 60/hour and the homepage falls
# back to the last known-good snapshot in entities/member/model/contributors.ts.
GITHUB_TOKEN=

# Backend base URL used by @cdc/api-client (Server Actions only).
CDC_BACKEND_URL=http://localhost:4000
