# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (monorepo: root + any nested node_modules)
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing / coverage (root or any workspace)
coverage/

# next.js
.next/
out/

# production builds
/build
dist/

# storybook
storybook-static/

# turborepo (in case it gets added later)
.turbo/

# env files — ignore real/local env files but keep committed templates
.env
.env.local
.env.*.local
!.env.example

# docker local overrides
docker-compose.override.yml

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# editors / OS
.claude/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini
*.pem

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.eslintcache
